{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "todo-app": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "server.js",
      "functions": {
        "server.js": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "todo-app"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/site-days",
      "schedule": "55 20 * * *"
    },
    {
      "path": "/api/cron/wise",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/deye",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/plants/check",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ajaltoun",
      "schedule": "0 5 * * *"
    }
  ]
}
